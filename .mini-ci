# How lagdynamics is tested on the Mac mini (ci VM). Run in the repo: mini-ci [job]
#   job NAME COMMAND (first = default) · env KEY=VALUE · sibling ../DIR · include PATH
#   fetch PATH · report cvs · node mac|X.Y.Z|system (mac = the same Node version as this Mac)
node system

# R package: dependencies (incl. Suggests) come from DESCRIPTION. A local package this one
# needs unreleased goes in as: sibling ../DIR
job test   Rscript -e 'testthat::test_local(stop_on_failure = TRUE)'
job check  Rscript -e 'r <- rcmdcheck::rcmdcheck(args = c("--no-manual", "--as-cran"), error_on = "never"); print(r); if (r$status != 0 || length(r$errors) || length(r$warnings)) quit(status = 1)'

# Prova Verify: capture of the equivalence tests, run as
#   mini-ci -- Rscript ../equivalence/lagdynamics/import-tests.R capture [file-regex]
# (the standing material git ignores is the copy kept in ../equivalence/lagdynamics/local; the driver copies it in)
include ../equivalence/lagdynamics/local
include ../equivalence/lagdynamics/import-tests.R
include ../equivalence/import-tests-common.R
include ../prova/.claude/worktrees/verify/reporters/verify-capture.R
fetch .ci/verify-capture

# The declared equivalence tests (tests/equivalence, the standard: ../equivalence/STANDARD.md): every
# comparison with a reference, recorded in .ci/verify-capture/capture.json. Then, on the Mac:
#   sh ../equivalence/push.sh lagdynamics
job verify Rscript -e 'source("tests/equivalence/helper-verify.R"); verify_tests(lib = "~/equiv-lib")'

# The legacy comparison case of the equivalence repository (../equivalence/lagdynamics/export-bundles.R), run here
# rather than on the Mac: mini-ci legacy (add case names after the script for others). The bundle comes back in
# .ci/legacy-bundles/; copy it to ../equivalence/lagdynamics/bundles/ and push it by hand (see ../equivalence/CLAUDE.md).
include ../equivalence/lagdynamics/export-bundles.R
include ../prova/.claude/worktrees/verify/reporters/verify.R
fetch .ci/legacy-bundles
job legacy mkdir -p .ci/legacy-bundles && PROVA_VERIFY_R=../prova/.claude/worktrees/verify/reporters/verify.R Rscript ../equivalence/lagdynamics/export-bundles.R alternative_engines bidirectional_engine && cp -R ../equivalence/lagdynamics/bundles/alternative_engines ../equivalence/lagdynamics/bundles/bidirectional_engine .ci/legacy-bundles/
